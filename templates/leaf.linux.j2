# Loopback (origen de los tuneles VXLAN)
ip addr add {{ loopback }}/32 dev lo 2>/dev/null || true
for i in /sys/class/net/eth*; do ip link set "$(basename $i)" up; done
{% for v in vlans %}
# VLAN {{ v.id }} ({{ v.name }}) -> VNI {{ v.vni }}
ip link add br{{ v.id }} type bridge 2>/dev/null || true
ip link add vxlan{{ v.vni }} type vxlan id {{ v.vni }} local {{ loopback }} dstport 4789 nolearning 2>/dev/null || true
ip link set vxlan{{ v.vni }} master br{{ v.id }}
ip link set br{{ v.id }} up
ip link set vxlan{{ v.vni }} up
{% endfor %}
# Puertos de acceso (hosts y equipos de la Entrega 2)
{% for port, vlan in access.items() %}
ip link set {{ port }} master br{{ vlan }}
ip link set {{ port }} up
{% endfor %}
{% include "srv6.linux.j2" %}

# SID End.DX4: desencapsula y entrega localmente el IPv4 interno (VXLAN dirigido por el controlador)
ip -6 route replace {{ sr }}:{{ n }}::d4/128 encap seg6local action End.DX4 nh4 {{ loopback }} dev sr0
