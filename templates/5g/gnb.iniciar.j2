# Arranca el gNodeB y espera el NG Setup con el AMF
pkill nr-gnb 2>/dev/null; sleep 0.5
: > /var/log/gnb.log
nohup nr-gnb -c /etc/gsm5g/gnb.yaml > /var/log/gnb.log 2>&1 </dev/null &
for i in $(seq 30); do grep -q "NG Setup procedure is successful" /var/log/gnb.log && break; sleep 1; done
grep -h -E "NG Setup|SCTP|error" /var/log/gnb.log | tail -4
