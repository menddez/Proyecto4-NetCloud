# Open5GS AMF - generado por deploy.py desde topology.yaml
logger:
  file:
    path: /opt/open5gs/var/log/open5gs/amf.log
global:
  max:
    ue: 64
amf:
  sbi:
    server:
      - address: 127.0.0.5
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.200:7777
  ngap:
    server:
      - address: {{ c5g.n2n3 }}
  guami:
    - plmn_id:
        mcc: {{ c5g.plmn.mcc }}
        mnc: {{ c5g.plmn.mnc }}
      amf_id:
        region: 2
        set: 1
  tai:
    - plmn_id:
        mcc: {{ c5g.plmn.mcc }}
        mnc: {{ c5g.plmn.mnc }}
      tac: {{ c5g.tac }}
  plmn_support:
    - plmn_id:
        mcc: {{ c5g.plmn.mcc }}
        mnc: {{ c5g.plmn.mnc }}
      s_nssai:
        - sst: 1
  security:
    integrity_order: [NIA2, NIA1, NIA0]
    ciphering_order: [NEA0, NEA1, NEA2]
  network_name:
    full: GSM-Cloud 5G Privado
    short: GSM5G
  amf_name: gsm-amf0
  time:
    t3512:
      value: 540
