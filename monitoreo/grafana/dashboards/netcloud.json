{
  "uid": "netcloud",
  "title": "NetCloud-Secure - Telemetria en tiempo real",
  "tags": ["gsm-cloud"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Nodos monitoreados activos", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "count(gsm_node_up == 1)", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "UEs 5G registrados", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "max(gsm_5g_amf_ues)", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Bloqueos Zero Trust (total)", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [
       {"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(gsm_nft_packets{table=\"zt\", counter=~\"ztdrop.*\"})", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "NGAP descartados (DDoS 5G)", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [
       {"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(gsm_nft_packets{table=\"g5\", counter=\"ngap_descartado\"})", "refId": "A"}]},
    {"id": 10, "type": "timeseries", "title": "Throughput por interfaz (Mbit/s, TX)",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
     "fieldConfig": {"defaults": {"unit": "Mbits", "custom": {"fillOpacity": 10}}},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(gsm_if_tx_bytes{iface!~\"sr0|dummy.*\"}[1m])*8/1e6", "legendFormat": "{{node}}/{{iface}}", "refId": "A"}]},
    {"id": 11, "type": "timeseries", "title": "Microsegmentacion: intentos este-oeste bloqueados (pps)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "fieldConfig": {"defaults": {"unit": "pps", "custom": {"fillOpacity": 20}}},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(gsm_nft_packets{table=\"zt\", counter=~\"ztdrop.*\"}[1m])", "legendFormat": "{{counter}}", "refId": "A"}]},
    {"id": 12, "type": "timeseries", "title": "5G: senalizacion al nucleo y autenticaciones fallidas",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "rate(gsm_nft_packets{table=\"g5\", counter=\"ngap\"}[1m])", "legendFormat": "NGAP aceptado (pps)", "refId": "A"},
       {"expr": "rate(gsm_nft_packets{table=\"g5\", counter=\"ngap_descartado\"}[1m])", "legendFormat": "NGAP descartado (pps)", "refId": "B"},
       {"expr": "rate(gsm_5g_auth_fallidos_total[1m])", "legendFormat": "auth fallidas/s", "refId": "C"}]},
    {"id": 13, "type": "timeseries", "title": "F5G: grant del DBA por ONT (Mbit/s)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
     "fieldConfig": {"defaults": {"unit": "Mbits"}},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "gsm_f5g_grant_mbps", "legendFormat": "{{ont}}", "refId": "A"}]}
  ]
}
